NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only: never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=configure-in-Vercel-server-environment
ETHER_ENQUIRIES_ENABLED=false
ETHER_PRIVACY_NOTICE_APPROVED=false

# Cloudflare Turnstile: public site key and server-only secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=configure-in-Vercel-server-environment

# Resend email notifications; use a sender on a verified domain.
RESEND_API_KEY=configure-in-Vercel-server-environment
ETHER_ENQUIRY_RECIPIENT=verified-staff-inbox@example.com
ETHER_ENQUIRY_FROM=verified-sender@example.com

# Must match the approved published privacy notice.
ETHER_PRIVACY_NOTICE_VERSION=not-approved
